// schema.prisma: es "la fuente de verdad" de tu base de datos.
// Equivalente en .NET: tus clases de entidad + el DbContext + la configuración de EF Core, todo junto en un archivo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  COMERCIANTE
  CLIENTE
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String        @unique
  // Obligatorio para ADMINISTRADOR y COMERCIANTE, null para CLIENTE (lo valida el servicio).
  // Postgres permite varios NULL en una columna @unique, así que los clientes no chocan entre sí.
  username     String?       @unique
  passwordHash String
  telefono     String?
  rol          Rol           @default(CLIENTE)
  estado       EstadoUsuario @default(ACTIVO)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("Usuario")
}
