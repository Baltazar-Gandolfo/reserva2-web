# Copiá este archivo a ".env" y completá tus valores. El ".env" real NO se sube a git.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/DBNAME?sslmode=require"
PORT=3000
FRONTEND_URL="http://localhost:5173"
# Secretos JWT: generar valores largos y aleatorios (node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET="cambiar"
JWT_REFRESH_SECRET="cambiar-otro-distinto"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
# Admin inicial para el seed (SOLO DESARROLLO: cambiar en produccion)
ADMIN_EMAIL="admin@reserva2.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin1234!"
